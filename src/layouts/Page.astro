---
import { link, pagePath, pages, site } from '../site';

interface Props {
  /** The page's own title; the site name is appended. Omit on the start page. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const path = pagePath(Astro.url.pathname);
const current = (target: string) => (path === link(target) ? 'page' : undefined);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {site.indexable ? null : <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="bar">
      <div class="wrap bar-inner">
        <a class="wordmark" href={link('/')}>{site.name}</a>
        <nav aria-label="Hauptnavigation">
          <a href={link('/methode')} aria-current={current('/methode')}>So wählen wir aus</a>
        </nav>
      </div>
    </header>
    <main id="inhalt" class="wrap">
      <slot />
    </main>
    <footer class="wrap">
      <div class="footer">
        <nav aria-label="Weitere Seiten">
          {
            pages.map(page => (
              <a href={link(page.path)} aria-current={current(page.path)}>
                {page.label}
              </a>
            ))
          }
        </nav>
        <p>{site.name}. Ein Kaufberater aus Deutschland.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/site.css';
</style>
