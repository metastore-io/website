---
import Page from '../layouts/Page.astro';
import { method } from '../method';

/**
 * The rules when this page is built (`maxAgeHours` in packages/scoring/src/offers.ts, `VERDICT_V1`
 * in verdict.ts); the app shows the live values from `GET /v1/method`.
 */
const values: Record<string, string> = {
  hours: '48',
  days: '90',
  good: '5\u00a0%',
  wait: '5\u00a0%',
  minDays: '30',
  minShops: '3',
};

const sections = method.sections.map(section => ({
  header: section.header,
  body: section.body.replace(/\{\{(\w+)\}\}/g, (_, key: string) => values[key] ?? ''),
}));
---

<Page title={method.title} description={method.intro}>
  <article class="article">
    <h1>{method.title}</h1>
    <p class="lead">{method.intro}</p>
    <ul class="rows">
      {
        sections.map(section => (
          <li>
            <h2>{section.header}</h2>
            <p>{section.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="footnote">
      Die aktuellen Gewichte, Quellen und Versionen zeigt die App auf derselben Seite.
    </p>
  </article>
</Page>
