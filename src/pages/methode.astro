---
import Page from '../layouts/Page.astro';
import { method } from '../method';

/** The offers rule when this page is built; the app shows the live value from `GET /v1/method`. */
const OFFER_MAX_AGE_HOURS = 48;

const sections = method.sections.map(
  section => ({
    header: section.header,
    body: section.body.replaceAll('{{hours}}', String(OFFER_MAX_AGE_HOURS)),
  }),
);
---

<Page title={method.title} description={method.intro}>
  <article class="article">
    <h1>{method.title}</h1>
    <p class="lead">{method.intro}</p>
    <ul class="rows">
      {
        sections.map(section => (
          <li>
            <h2>{section.header}</h2>
            <p>{section.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="footnote">
      Die aktuellen Gewichte, Quellen und Versionen zeigt die App auf derselben Seite.
    </p>
  </article>
</Page>
